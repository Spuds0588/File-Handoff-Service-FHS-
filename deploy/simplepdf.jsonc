{
  // Production profile for the existing SimplePDF deployment. Wrangler does
  // not merge configs, so this file is complete. Change "name" for a separate
  // Worker; keep the binding and migration identical.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "file-handoff-service",
  "main": "../src/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,

  "durable_objects": {
    "bindings": [{ "name": "HANDOFF_VAULT", "class_name": "HandoffVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HandoffVault"] }],

  "observability": { "enabled": true },

  "vars": {
    "TTL_SECONDS": "300",
    "ALLOWED_CONTENT_TYPES": "application/pdf",
    "REQUIRE_PDF_MAGIC": "true",
    "ALLOWED_RETRIEVE_DOMAINS": "simplepdf.com,*.simplepdf.com"
  }
}
