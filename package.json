{
  "name": "file-handoff-service",
  "version": "1.0.0",
  "description": "Ephemeral, single-use, zero-retention file relay on Cloudflare Workers and Durable Objects.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup.mjs --repo .",
    "tail": "wrangler tail",
    "test:setup": "node test/setup.test.mjs",
    "test:e2e": "node test/e2e.test.mjs",
    "test:filters": "node test/filters.test.mjs",
    "test:sides": "node test/sides.test.mjs",
    "test": "npm run test:setup && npm run test:e2e && npm run test:filters && npm run test:sides"
  },
  "devDependencies": {
    "wrangler": "4.80.0"
  }
}
