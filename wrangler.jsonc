{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "file-handoff-service",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,

  // One class, one binding. The class never touches storage, but new Durable
  // Object namespaces must use the SQLite backend, so it is declared that way.
  "durable_objects": {
    "bindings": [{ "name": "HANDOFF_VAULT", "class_name": "HandoffVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HandoffVault"] }],

  "observability": { "enabled": true }

  // Optional runtime overrides (defaults shown). Uncomment and redeploy. Filters
  // are open when omitted; each side can be set independently. Use
  // `wrangler secret put UPLOAD_SECRET` and/or `RETRIEVE_SECRET` for bearer gates.
  //
  // "vars": {
  //   "TTL_SECONDS": "60",
  //   "MAX_PAYLOAD_BYTES": "26214400",
  //   "CHUNK_SIZE_BYTES": "8388608",
  //   "ALLOWED_CONTENT_TYPES": "application/pdf,image/*",
  //   "ALLOWED_UPLOAD_DOMAINS": "app.example.com,*.example.org",
  //   "ALLOWED_RETRIEVE_DOMAINS": "consumer.example.org"
  // }
}
